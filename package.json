{
  "name": "jotas-brain",
  "version": "1.0.0",
  "description": "Jota's Brain — prospecção de criadores do YouTube",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.jotasbrain.desktop",
    "productName": "Jota's Brain",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "icon.png",
      "icon.ico",
      "qrcode.min.js"
    ],
    "extraResources": [
      {
        "from": "discord-presence.json",
        "to": "discord-presence.json"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "JotasBrain-Portable.exe"
    }
  }
}
